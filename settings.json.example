{
  "_comment": "Шаблон settings.json. Скопируй и переименуй в settings.json рядом с asud.exe — exe подхватит без пересборки. Любой ключ можно убрать — будет взято значение по умолчанию из DEFAULTS в коде. config.json (старое имя) тоже работает — для обратной совместимости.",

  "_comment_presets": "Каждый пресет — отдельный сценарий в меню при запуске asud.exe без флагов. Поля: name (как показать), mode (mix/smart/auto-create/email), folder (источник .msg для email-flow), xlsx (путь к реестру для mix/auto-create/smart), outlook_dir (папка где искать .msg по Link для mix-вложений; может совпадать с folder или нет), output_suffix (добавляется в имя per-date xlsx чтобы не конфликтовали реестры разных пресетов), delete_after_done (true → удалять обработанные .msg вместо переноса в Завершено/; удобно для daemon-режима).",
  "presets": [
    {
      "name": "ОЭК — Smart (черновики)",
      "mode": "smart",
      "folder": "D:\\OutlookSubjects\\ОЭК",
      "xlsx": "D:\\OutlookSubjects\\ОЭК\\ОЭК.xlsx",
      "outlook_dir": "D:\\OutlookSubjects\\ОЭК",
      "output_suffix": "ОЭК",
      "delete_after_done": true
    },
    {
      "name": "ТЭС — Mix (с регистрацией)",
      "mode": "mix",
      "folder": "D:\\OutlookSubjects\\ТЭС",
      "xlsx": "D:\\OutlookSubjects\\ТЭС\\ТЭС.xlsx",
      "outlook_dir": "D:\\OutlookSubjects\\ТЭС",
      "output_suffix": "ТЭС",
      "delete_after_done": true
    },
    {
      "name": "ГИС ЖКХ — Mix (с регистрацией)",
      "mode": "mix",
      "folder": "D:\\OutlookSubjects\\ГИСЖКХ",
      "xlsx": "D:\\OutlookSubjects\\ГИСЖКХ\\ГИСЖКХ.xlsx",
      "outlook_dir": "D:\\OutlookSubjects\\ГИСЖКХ",
      "output_suffix": "ГИСЖКХ"
    }
  ],

  "email_watch_interval_sec": 30,
  "email_max_retries": 3,

  "asud_url": "https://asud.interrao.ru/asudik/",
  "unknown_correspondent": "Неизвестный Неизвестный Неизвестный",

  "_comment_zhkh_daemon": "Конфиг непрерывного daemon'а под Басмановым (mode=zhkh-daemon). Опрашивает реестры в каждые poll_interval_sec секунд, для новых строк (Номер заполнен, «Отписано Халецкой» пуст) выдаёт резолюцию Халецкой и отмечает дату. Имена реестров: <output_suffix>_резолюции.xlsx (один накопительный файл на пресет, без даты в имени). Дата регистрации каждой записи лежит в колонке «Статус» внутри xlsx.",
  "zhkh_daemon": {
    "watch": [
      {"dir": "D:\\OutlookSubjects\\ГИСЖКХ", "xlsx_pattern": "ГИСЖКХ_резолюции.xlsx"},
      {"dir": "D:\\OutlookSubjects\\ТЭС",    "xlsx_pattern": "ТЭС_резолюции.xlsx"}
    ],
    "poll_interval_sec": 30,
    "switch_to_user": "Басманов",
    "sidebar_section": "На резолюцию",
    "executor_fio": "Халецкая Юлия Владимировна",
    "content_template": "Для работы",
    "require_report": true,
    "control_resolution": true,
    "fallback_days": 3
  }
}
