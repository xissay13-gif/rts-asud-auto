{
  "_comment": "Шаблон settings.json. Скопируй и переименуй в settings.json рядом с asud.exe — exe подхватит без пересборки. Любой ключ можно убрать — будет взято значение по умолчанию из DEFAULTS в коде. config.json (старое имя) тоже работает — для обратной совместимости.",

  "_comment_presets": "Каждый пресет — отдельный сценарий в меню при запуске asud.exe без флагов. Поля: name (как показать), mode (mix/smart/auto-create/email), folder (источник .msg для email-flow — ОДНА папка) ИЛИ folders (список папок для round-robin мониторинга), xlsx (путь к реестру для mix/auto-create/smart), outlook_dir (папка где искать .msg по Link для mix-вложений; может совпадать с folder или нет), output_suffix (добавляется в имя per-date xlsx чтобы не конфликтовали реестры разных пресетов), round_robin (true — в watch-режиме обходит folders по очереди; false — все папки на каждом тике), delete_after_done (по умолчанию true — обработанные .msg удаляются; поставь false если хочешь бэкап в Завершено/), registration_backend/asud_api_enabled (только для отдельного API TEST пресета).",
  "presets": [
    {
      "name": "ОЭК — Smart (черновики)",
      "mode": "smart",
      "folder": "D:\\OutlookSubjects\\ОЭК",
      "xlsx": "D:\\OutlookSubjects\\ОЭК\\ОЭК.xlsx",
      "outlook_dir": "D:\\OutlookSubjects\\ОЭК",
      "output_suffix": "ОЭК",
      "delete_after_done": true
    },
    {
      "name": "ТЭС — Mix (с регистрацией)",
      "mode": "mix",
      "folder": "D:\\OutlookSubjects\\ТЭС",
      "xlsx": "D:\\OutlookSubjects\\ТЭС\\ТЭС.xlsx",
      "outlook_dir": "D:\\OutlookSubjects\\ТЭС",
      "output_suffix": "ТЭС",
      "delete_after_done": true
    },
    {
      "name": "ГИС ЖКХ — Mix (с регистрацией)",
      "mode": "mix",
      "folder": "D:\\OutlookSubjects\\ГИСЖКХ",
      "xlsx": "D:\\OutlookSubjects\\ГИСЖКХ\\ГИСЖКХ.xlsx",
      "outlook_dir": "D:\\OutlookSubjects\\ГИСЖКХ",
      "output_suffix": "ГИСЖКХ"
    },
    {
      "id": "gis-api-test",
      "name": "ГИС ЖКХ — API TEST (dry-run)",
      "mode": "mix",
      "folder": "D:\\OutlookSubjects\\ГИСЖКХ",
      "outlook_dir": "D:\\OutlookSubjects\\ГИСЖКХ",
      "output_suffix": "ГИСЖКХ_API_TEST",
      "registration_backend": "asud_api",
      "asud_api_enabled": false,
      "delete_after_done": false
    },
    {
      "name": "Все потоки (round-robin) — Mix",
      "mode": "mix",
      "folders": [
        {"dir": "D:\\OutlookSubjects\\ОЭК",    "output_suffix": "ОЭК"},
        {"dir": "D:\\OutlookSubjects\\ТЭС",    "output_suffix": "ТЭС"},
        {"dir": "D:\\OutlookSubjects\\ГИСЖКХ", "output_suffix": "ГИСЖКХ"}
      ],
      "round_robin": true,
      "delete_after_done": true
    },
    {
      "id": "sbis",
      "name": "СБИС — регистрация входящих",
      "mode": "sbis",
      "folder": "D:\\SBIS\\sbis_downloads\\КоррВх"
    }
  ],

  "_comment_intervals": "Интервалы в СЕКУНДАХ. email_watch_interval_sec — как часто email-daemon (--watch) опрашивает папку с .msg. По умолчанию 300 (5 минут).",
  "email_watch_interval_sec": 300,
  "email_max_retries": 3,

  "_comment_asud_api": "ОПЫТНЫЙ РЕЖИМ ТОЛЬКО ДЛЯ ГИС ЖКХ. Без явного включения остаётся dry-run и ничего не меняет в АСУД. Заполни только подтверждённые владельцем API URL/пути и ID. Пароли/токены запрещено писать в settings.json: авторизация задаётся только переменными ASUD_API_AUTH_TYPE и соответствующими ASUD_API_* env (см. GIS_ZHKH_API_TEST.md).",
  "_comment_asud_api_env": "Несекретные override'ы: ASUD_API_ENABLED, ASUD_API_MODE, ASUD_API_ALLOW_MUTATIONS, ASUD_API_MAX_DOCUMENTS, ASUD_API_BASE_URL, ASUD_API_FIND_OBJECTS2_URL, ASUD_API_FIND_APPOINTMENT_URL, ASUD_API_HANDLE_OBJECT_URL, ASUD_API_GET_OBJECT_URL, ASUD_API_EXECUTE_ACTION_URL, ASUD_API_TIMEOUT_SEC, ASUD_API_VERIFY_TLS, ASUD_API_LIS, ASUD_API_USER, ASUD_API_BRANCH_ID, ASUD_API_BRANCH_NAME, ASUD_API_INCOMING_TYPE_PATH, ASUD_API_ADDRESSEE_ID, ASUD_API_ADDRESSEE_NAME, ASUD_API_AUTHOR_ID, ASUD_API_AUTHOR_ATTRIBUTE, ASUD_API_DELIVERY_TYPE, ASUD_API_REGISTRATION_ACTION, ASUD_API_RESOLUTION_ACTION, ASUD_API_BRANCH_ATTRIBUTE, ASUD_API_CONFIRM_MSG_SUPPORTED, ASUD_API_MAX_ATTACHMENT_BYTES. Секреты только через ASUD_API_AUTH_TYPE + ASUD_API_BASIC_USERNAME/PASSWORD, ASUD_API_BEARER_TOKEN или ASUD_API_AUTH_HEADER_NAME/VALUE.",
  "asud_api": {
    "enabled": false,
    "mode": "dry-run",
    "allow_mutations": false,
    "max_documents": 1,
    "base_url": "",
    "endpoints": {
      "find_objects2": "",
      "find_appointment": "",
      "handle_object": "",
      "get_object": "",
      "execute_action": ""
    },
    "timeout_sec": 30,
    "verify_tls": true,
    "lis": "",
    "user": "",
    "branch_id": "",
    "branch_name": "",
    "incoming_type_path": "",
    "addressee_id": "",
    "addressee_name": "Басманов Александр Владимирович",
    "author_id": "",
    "author_attribute": "",
    "delivery_type": "",
    "registration_action": "registration",
    "resolution_action": "",
    "incoming_attributes": {},
    "branch_attribute": "",
    "attachment": {
      "confirm_msg_supported": false,
      "max_bytes": 0
    }
  },

  "asud_url": "https://asud.interrao.ru/asudik/",
  "unknown_correspondent": "Неизвестный Неизвестный Неизвестный",
  "addressees": ["Басманов Александр Владимирович"],

  "_comment_zhkh_excluded_topics": "Эти темы ГИС ЖКХ вообще не создаются и не регистрируются в АСУД. MSG остаётся в корне (чтобы выгрузчик не скачал его повторно), рядом создаётся .asud_terminal.json, и монитор больше его не видит. Сопоставление строго по полному названию; код темы хранится только для лога.",
  "zhkh_excluded_topics": {
    "2.1": "Отсутствие отопления",
    "2.2": "Отсутствие водоснабжения",
    "2.3": "Нарушение температурного режима подачи воды",
    "2.16": "Порыв труб",
    "2.25": "Затопление подвала",
    "5.1": "Качество оказания коммунальных услуг",
    "5.2": "Сроки оказания коммунальных услуг",
    "23": "Некачественная поставка ресурса"
  },
  "_comment_sbis": "Режим sbis регистрирует каждый PDF отдельно. Имена [ФЛ][Полное ФИО] Содержание.pdf и [ЮЛ][Полное название] Содержание.pdf разбираются без чтения PDF. ФЛ ищется/создаётся по ФИО и получает тип 8; для ЮЛ полное название записывается в фамилию, имя и отчество — прочерки, тип 5. Номер — б/н (N). Старые имена тоже поддерживаются.",
  "sbis": {
    "surname_override": "",
    "doc_type_index": 8,
    "person_doc_type_index": 8,
    "legal_doc_type_index": 5,
    "include_extension_in_content": false,
    "extensions": [".pdf", ".doc", ".docx", ".rtf", ".txt", ".xls", ".xlsx", ".xml", ".zip", ".jpg", ".jpeg", ".png", ".tif", ".tiff"]
  },

  "_comment_zhkh_daemon": "Конфиг непрерывного daemon'а под Басмановым (mode=zhkh-daemon). Опрашивает реестры в каждые poll_interval_sec секунд, для новых строк (Номер заполнен, «Отписано Халецкой» пуст) выдаёт резолюцию Халецкой. round_robin: true → каждый тик берёт ОДИН реестр по очереди (тик1=ГИСЖКХ, тик2=ТЭС, тик3=ОЭК, тик4=ГИСЖКХ,...). false (дефолт) → каждый тик все реестры.",
  "zhkh_daemon": {
    "watch": [
      {"dir": "D:\\OutlookSubjects\\ГИСЖКХ", "xlsx_pattern": "ГИСЖКХ_резолюции.xlsx"},
      {"dir": "D:\\OutlookSubjects\\ТЭС",    "xlsx_pattern": "ТЭС_резолюции.xlsx"},
      {"dir": "D:\\OutlookSubjects\\ОЭК",    "xlsx_pattern": "ОЭК_резолюции.xlsx"}
    ],
    "poll_interval_sec": 300,
    "round_robin": false,
    "switch_to_user": "Басманов",
    "sidebar_section": "На резолюцию",
    "executor_fio": "Халецкая Юлия Владимировна",
    "content_template": "Для работы",
    "require_report": true,
    "control_resolution": true,
    "fallback_days": 3
  }
}
