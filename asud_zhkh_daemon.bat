@echo off
chcp 65001 > nul
REM Непрерывный мониторинг реестров под учёткой Басманова.
REM Опрашивает реестры (по списку из settings.json → zhkh_daemon.watch),
REM для каждого нового документа с заполненной «Номер» и пустой «Отписано
REM Халецкой» выдаёт резолюцию и отмечает дату.
REM Ctrl+C — корректная остановка после текущего документа.

cd /d "%~dp0"
"%~dp0asud.exe" --mode=zhkh-daemon --headless

pause
