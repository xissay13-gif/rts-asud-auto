@echo off
chcp 65001 > nul
REM SYNC-режим: пересмотр всех строк реестров и сверка с АСУД.
REM НЕ создаёт резолюций, только обновляет статус в xlsx если в АСУД
REM уже есть резолюция (которую daemon мог пропустить из-за PermissionError
REM при сейве, ручной правки в АСУД или рассинхрона по другой причине).
REM
REM Запускать ПЕРЕД обычным daemon'ом утром или раз в неделю.
REM Пресет 1 — «Округа → начальницам (под Халецкой)».

cd /d "%~dp0"
"%~dp0asud_resolutions.exe" --headless --preset 1 --yes --sync-only

pause
